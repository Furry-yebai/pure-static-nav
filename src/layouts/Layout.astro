---
import '../styles/global.css';
import { ThemeToggle } from '../components/ThemeToggle';
import { Notification } from '../components/Notification';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="zh-CN" suppressHydrationWarning>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content="常用网站导航" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <title>{title}</title>
    <script is:inline>
      // Theme init
      (function() {
        var s = localStorage.getItem('theme');
        var mq = window.matchMedia('(prefers-color-scheme: dark)');
        var dark = s ? s === 'dark' : mq.matches;
        document.documentElement.classList.toggle('dark', dark);
        mq.addEventListener('change', function() {
          if (!localStorage.getItem('theme')) {
            document.documentElement.classList.toggle('dark', mq.matches);
          }
        });
      })();
    </script>

  </head>
  <body class="min-h-screen">
    <div id="bing-bg" class="bing-bg"></div>
    <div class="custom-cursor" id="custom-cursor"></div>
    <ThemeToggle client:load />
    <Notification client:load />
    <div class="relative z-10">
      <slot />
    </div>
  </body>
</html>

<style>
  .bing-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: var(--wallpaper);
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    background-repeat: no-repeat;
    z-index: -2;
    background-color: #f5f5f7;
  }
  :root:not(.dark) .bing-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(245, 245, 247, 0.75);
  }
  .dark .bing-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(29, 29, 31, 0.8);
  }

  .custom-cursor {
    position: fixed;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #fff;
    pointer-events: none;
    z-index: 99999;
    transform: translate(-50%, -50%);
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.15s ease-out;
    mix-blend-mode: difference;
    opacity: 0;
  }

  .custom-cursor.visible {
    opacity: 1;
  }

  .custom-cursor.hover {
    transform: translate(-50%, -50%) scale(2);
  }
</style>
